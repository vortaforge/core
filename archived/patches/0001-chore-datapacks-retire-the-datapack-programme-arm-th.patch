--- /dev/null
+++ b/.githooks/pre-push
@@ -0,0 +1,58 @@
+#!/bin/sh
+# .githooks/pre-push - refuse a push that creates datapack content, revives
+# archived tooling, or carries commits by blocklisted accounts.
+#
+# Install once with:  git config core.hooksPath .githooks
+#
+# stdin (from git) is "<local ref> <local sha> <remote ref> <remote sha>" per
+# ref being pushed. remote sha of all zeros means "new branch"; a non-zero
+# remote sha that is not an ancestor of the local sha means a force-push.
+set -eu
+repo_root=$(git rev-parse --show-toplevel)
+cd "$repo_root"
+
+if [ ! -f scripts/datapack_guard.py ]; then
+    echo "pre-push: scripts/datapack_guard.py is missing - refusing to push (fail-closed)." >&2
+    exit 1
+fi
+
+status=0
+remote_name=${1:-origin}
+while read -r local_ref local_sha remote_ref remote_sha; do
+    [ -z "${local_ref:-}" ] && continue
+    case "$local_ref" in refs/heads/*) ;; *) continue ;; esac
+
+    : "${PRE_PUSH_REF:=$remote_ref}"
+    export PRE_PUSH_REF
+
+    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
+        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
+            PRE_PUSH_FORCE=1
+            export PRE_PUSH_FORCE
+            echo "pre-push: force-push detected on $remote_ref." >&2
+        else
+            PRE_PUSH_FORCE=0
+            export PRE_PUSH_FORCE
+        fi
+        base="$remote_sha"
+    else
+        PRE_PUSH_FORCE=0
+        export PRE_PUSH_FORCE
+        base=$(git rev-list --max-parents=0 "$local_sha" | tail -n 1)
+    fi
+
+    if [ -n "$base" ] && [ "$base" != "0000000000000000000000000000000000000000" ]; then
+        python3 scripts/datapack_guard.py --base "$base" --push --protect --blocklist \
+            --check-archive || status=1
+    else
+        echo "pre-push: could not determine a base commit for $local_ref; failing closed." >&2
+        status=1
+    fi
+done
+
+if [ "$status" -ne 0 ]; then
+    echo "" >&2
+    echo "pre-push: push refused. See docs/ARCHIVAL.md for the policy and the" >&2
+    echo "           only sanctioned way to change archived/ (a new registry entry)." >&2
+fi
+exit "$status"
