{
  "schemaVersion": 1,
  "id": "rtwrapper",
  "version": "${version}",
  "name": "RTWrapper",
  "description": "Queued, permission-checked native command dispatch API for other mods/datapacks. Fabric reimplementation of the RTWrapper datapack protocol.",
  "authors": [
    "VortaForge",
    "Runtoolkit (original source)"
  ],
  "contact": {
    "homepage": "https://github.com/vortaforge/core",
    "issues": "https://github.com/vortaforge/core/issues",
    "sources": "https://github.com/vortaforge/core"
  },
  "license": "Unlicense",
  "icon": "icon.png",
  "provides": [
    "VortaForge"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.vortacraftmc.rtwrapper.RTWrapper"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": "*",
    "minecraft": "~1.21.1"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
