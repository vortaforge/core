{
  "type": "minecraft:multi_action",
  "title": {
    "translate": "macroengine.dialog.setup_warning.title",
    "fallback": "macroEngine server warning",
    "color": "gold",
    "bold": true
  },
  "external_title": {
    "translate": "macroengine.dialog.setup_warning.title",
    "fallback": "macroEngine server warning",
    "color": "gold"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "macroengine.dialog.setup_warning.body",
        "fallback": "This copy of macroEngine was installed by, and is controlled by, the operator of this server or world - not by the macroEngine developers.\n\nThe operator controls this pack's settings and stored data. Do not enter passwords, tokens, verification codes, private messages, or any other sensitive information into chat, books, signs, name tags, anvils, or other inputs.\n\nIf you do not know or trust this server/world, choose Cancel and leave. Continue only opens the next screen; it does not grant consent by itself.",
        "color": "white"
      },
      "width": 380
    }
  ],
  "actions": [
    {
      "label": {
        "translate": "macroengine.dialog.setup_warning.continue",
        "fallback": "Continue",
        "color": "green",
        "bold": true
      },
      "tooltip": {
        "translate": "macroengine.dialog.setup_warning.continue_tooltip",
        "fallback": "Open the separate yes/no screen. This does not enable macroEngine yet.",
        "color": "gray"
      },
      "width": 220,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "macroengine:setup_warning_confirm"
      }
    },
    {
      "label": {
        "translate": "macroengine.dialog.setup_warning.more_info",
        "fallback": "More information",
        "color": "aqua",
        "underlined": true
      },
      "tooltip": {
        "translate": "macroengine.dialog.setup_warning.more_info_tooltip",
        "fallback": "Open the macroEngine player safety information page.",
        "color": "gray"
      },
      "width": 220,
      "action": {
        "type": "minecraft:open_url",
        "url": "https://github.com/vortaforge/core/blob/main/packs/macroEngine-Datapack-v26.3/INFO.md"
      }
    }
  ],
  "columns": 1,
  "exit_action": {
    "label": {
      "translate": "gui.cancel",
      "fallback": "Cancel",
      "color": "red"
    },
    "tooltip": {
      "translate": "macroengine.dialog.setup_warning.keep_inactive",
      "fallback": "Keep macroEngine inactive for your player only.",
      "color": "gray"
    },
    "width": 220,
    "action": {
      "type": "minecraft:run_command",
      "command": "trigger macroengine.consent set 2"
    }
  },
  "can_close_with_escape": true,
  "pause": true,
  "after_action": "close"
}
