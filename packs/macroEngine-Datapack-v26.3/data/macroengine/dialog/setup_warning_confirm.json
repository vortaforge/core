{
  "type": "minecraft:confirmation",
  "title": {
    "text": "Use macroEngine here?",
    "color": "gold",
    "bold": true
  },
  "external_title": {
    "text": "macroEngine yes/no confirmation",
    "color": "gold"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Choose yes only if you understand the warning and trust this server/world.\n\nyes records consent for your player only. no keeps macroEngine inactive for your player only. Neither choice changes another player's setting.",
        "color": "white"
      },
      "width": 360
    }
  ],
  "yes": {
    "label": {
      "text": "yes",
      "color": "green",
      "bold": true
    },
    "tooltip": {
      "text": "Enable macroEngine for your player only.",
      "color": "gray"
    },
    "width": 160,
    "action": {
      "type": "minecraft:run_command",
      "command": "trigger macroengine.consent set 4"
    }
  },
  "no": {
    "label": {
      "text": "no",
      "color": "red",
      "bold": true
    },
    "tooltip": {
      "text": "Keep macroEngine inactive for your player only.",
      "color": "gray"
    },
    "width": 160,
    "action": {
      "type": "minecraft:run_command",
      "command": "trigger macroengine.consent set 3"
    }
  },
  "can_close_with_escape": true,
  "pause": true,
  "after_action": "close"
}
